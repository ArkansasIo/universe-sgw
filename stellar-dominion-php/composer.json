{
    "name": "arkansas/stellar-dominion-php",
    "description": "PHP 8 + MySQL rework of Stellar Dominion 3.5 (port of the TypeScript/React 4X space MMO)",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.1",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "ext-json": "*"
    },
    "autoload": {
        "psr-4": {
            "StellarDominion\\": "app/"
        }
    },
    "scripts": {
        "db:migrate": "php database/migrate.php",
        "db:seed": "php database/seed.php",
        "tick": "php cron/tick.php",
        "test": "php tests/run.php"
    }
}
